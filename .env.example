# Live scoring / players database (see prisma/schema.prisma).
# Provision a free Postgres instance at https://supabase.com or https://neon.tech,
# then paste its connection string here. Not required for `npm run dev` —
# the app runs entirely on local fixtures until src/lib/data/*.ts is updated
# to read from it.
DATABASE_URL=""

# Headless WordPress content source, once WordPress is set up as the news CMS.
# e.g. https://cms.yourdomain.com/wp-json/wp/v2
WORDPRESS_API_URL=""

# Shared secret WordPress's "on publish" webhook sends to /api/revalidate so
# new posts appear without a full rebuild. Any random string.
REVALIDATE_SECRET=""

# RapidAPI key for the UK Golf Course Data API (golfapi.uk), used by the
# "Import course from UK Golf API" tool in the Venues admin to pull real
# hole-by-hole par/yardage/stroke-index data. Sign up (free tier available,
# no card needed) at https://rapidapi.com/raznut303/api/uk-golf-course-data-api
UK_GOLF_API_KEY=""
