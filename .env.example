# Postgres connection string for Payload (collections, scoring, players).
# DATABASE_URI is the name Payload's own docs use; DATABASE_URL is accepted as well
# and takes precedence if both are set. payload.config.ts rewrites a Supabase pooler
# host onto the transaction-mode port (6543) automatically, so paste the string as
# Supabase gives it to you.
#
# Note: `vercel env pull` writes DATABASE_URL="[SENSITIVE]" for an env var marked
# sensitive rather than the real value. payload.config.ts treats that literal as
# unset -- left alone, pg parses it as a host called "base" and every query fails
# with ENOTFOUND while the build still exits 0.
DATABASE_URI=""

# Headless WordPress content source, once WordPress is set up as the news CMS.
# e.g. https://cms.yourdomain.com/wp-json/wp/v2
WORDPRESS_API_URL=""

# Shared secret WordPress's "on publish" webhook sends to /api/revalidate so
# new posts appear without a full rebuild. Any random string.
REVALIDATE_SECRET=""

# RapidAPI key for the UK Golf Course Data API (golfapi.uk), used by the
# "Import course from UK Golf API" tool in the Venues admin to pull real
# hole-by-hole par/yardage/stroke-index data. Sign up (free tier available,
# no card needed) at https://rapidapi.com/raznut303/api/uk-golf-course-data-api
UK_GOLF_API_KEY=""

# Resend API key -- without this, Payload has no way to actually deliver account
# emails (forgot-password chief among them); it just logs the subject line and drops
# the message. Sign up at https://resend.com, verify the sending domain used in
# payload.config.ts's defaultFromAddress (Resend dashboard > Domains), then create
# an API key (dashboard > API Keys) and paste it here.
RESEND_API_KEY=""
